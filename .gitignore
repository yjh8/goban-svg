# --- Python (uv) — root-anchored per fleet D-222 lesson ---
/.venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/dist/
/*.egg-info/
__pycache__/
*.pyc

# --- Generated / transient (never source-of-truth) ---
/outputs/

# --- Raw input inbox (curated copies land in examples/, tracked) ---
/screenshots/

# --- macOS ---
.DS_Store

# --- Web deploy staging (rebuilt by scripts/deploy-web.sh) ---
/web-dist/
/.wrangler/

# --- Per-project Codex state (holds auth.json — NEVER commit) ---
# scripts/codex-review.sh runs every review against this isolated CODEX_HOME so
# ChatGPT.app's embedded codex cannot rewrite the cache out from under a run
# (docs/build-learnings.md 2026-08-21).
/.codex-home/
