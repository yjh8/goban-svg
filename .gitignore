# --- Python (uv) — root-anchored per fleet D-222 lesson ---
/.venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/dist/
/*.egg-info/
__pycache__/
*.pyc

# --- Generated / transient (never source-of-truth) ---
/outputs/

# --- Raw input inbox (curated copies land in examples/, tracked) ---
/screenshots/

# --- macOS ---
.DS_Store

# --- Web deploy staging (rebuilt by scripts/deploy-web.sh) ---
/web-dist/
/.wrangler/

# --- Codex review state ---
# scripts/codex-review.sh keeps per-project CODEX_HOME state in
# ~/.codex-homes/<project>/ — OUTSIDE the repo, because it holds a copy of
# auth.json and anything in-tree is inside the review boundary (r7 BLOCKER).
# This entry remains as a guard against an accidental in-repo home.
/.codex-home/
