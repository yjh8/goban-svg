# --- Python (uv) — root-anchored per fleet D-222 lesson ---
/.venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/dist/
/*.egg-info/
__pycache__/
*.pyc

# --- Generated / transient (never source-of-truth) ---
/outputs/

# --- Raw input inbox (curated copies land in examples/, tracked) ---
/screenshots/

# --- macOS ---
.DS_Store

# --- Web deploy staging (rebuilt by scripts/deploy-web.sh) ---
/web-dist/
/.wrangler/

# --- Codex review state ---
# scripts/codex-review.sh keeps per-project CODEX_HOME state in
# ~/.codex-homes/<basename>-<path-hash>/ — outside every repo, with auth.json a
# symlink rather than a copy. This entry guards against an in-repo home being
# re-introduced by accident (it would sit inside the review boundary).
/.codex-home/
